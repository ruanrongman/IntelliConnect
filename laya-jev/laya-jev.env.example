# Copy to /etc/laya-jev/laya-jev.env and allow only root plus the service group to read it.
# Keep this file out of Git when it contains a real key.
LAYA_HOST=127.0.0.1
LAYA_PORT=8001
LAYA_DEVICE=cpu
LAYA_MODEL_PATH=/opt/laya-jev/laya-jev/.runtime/models/multilingual

# Optional: set this to the same value used by ai.jev.key in Java.
# LAYA_API_KEY=replace-with-a-long-random-value

# Omit these two values for automatic CPU and memory based allocation.
# LAYA_WORKERS=2
# LAYA_THREADS=3

LAYA_REQUEST_TIMEOUT_SECONDS=8
# Restart only when native inference is still running past this longer deadline.
LAYA_INFERENCE_TIMEOUT_SECONDS=60
LAYA_BUSY_RETRY_SECONDS=3
LAYA_STARTUP_TIMEOUT_SECONDS=300
LAYA_MAX_TOKENS=8192
LAYA_MAX_QUESTIONS=32
LAYA_MAX_BATCH_TOKENS=16384
HF_HOME=/opt/laya-jev/laya-jev/.runtime/huggingface
PYTHONUNBUFFERED=1
PYTHONUTF8=1
